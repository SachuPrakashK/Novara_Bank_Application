{
  "realm": "novara-workforce-test",
  "enabled": true,
  "displayName": "Novara Workforce Test — Disposable POC",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 3,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 20,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "clients": [
    {
      "clientId": "novara-workforce-poc",
      "name": "Disposable workforce authorization POC",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${NOVARA_WORKFORCE_POC_CLIENT_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://127.0.0.1:18080/login/oauth2/code/workforce-poc"],
      "webOrigins": ["http://127.0.0.1:14200"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "audience-workforce-poc-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": { "included.custom.audience": "novara-workforce-poc-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "novara-workforce-verifier",
      "name": "Disposable cryptographic verifier",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${NOVARA_WORKFORCE_VERIFIER_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-workforce-poc-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": { "included.custom.audience": "novara-workforce-poc-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    }
  ],
  "requiredActions": [
    { "alias": "CONFIGURE_TOTP", "name": "Configure OTP", "providerId": "CONFIGURE_TOTP", "enabled": true, "defaultAction": true }
  ],
  "users": []
}
